# Copy with: cp .env.example .env   (.env is never committed)
# The values in this file are for local development only.

POSTGRES_DB=smart_appointment
POSTGRES_USER=sas
POSTGRES_PASSWORD=change-me-local-only

# Backend (used once backend code exists)
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=false
SWAGGER_ENABLED=true
# At least 32 characters; the backend refuses to start with a shorter secret.
JWT_SECRET=change-me-at-least-32-characters-long
JWT_LIFETIME=8h
MAIL_FROM=no-reply@smart-appointment.local

# FCM (after the MVP): path to the service account file, kept outside the repo
FIREBASE_CREDENTIALS_PATH=
