    "@mantine/notifications": "9.8.0",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "5.108.2",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "8.0.0",
